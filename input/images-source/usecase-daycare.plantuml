@startuml
scale max 650 width
left to right direction
skinparam shadowing false
skinparam defaultFontName "Microsoft JhengHei"
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
skinparam usecase {
  BackgroundColor white
  BorderColor #6f7d89
  ArrowColor gray
}
skinparam actor {
  BorderColor gray
}

actor "業務承辦人員" as Caseworker

rectangle "未滿兩歲兒童\n育兒津貼資訊系統" as Baby #DDEBF7 {
  usecase "彙整每日正在領取\n育兒津貼的資格資料" as PrepareEligibility
  usecase "傳送資格資料" as SendEligibility
}

rectangle "托育服務\n資訊整合系統" as Daycare #E2F0D9 {
  usecase "接收資格資料" as ReceiveEligibility
  usecase "比對補助資格\n互斥情形" as CheckEligibility
}

Caseworker -- PrepareEligibility
PrepareEligibility -down-> SendEligibility
SendEligibility -right-> ReceiveEligibility
ReceiveEligibility -down-> CheckEligibility
@enduml
